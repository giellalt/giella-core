###########################################
########## LexD build rules. ##########
###########################################

####### HFST build rules: ########
.generated/lexicon.tmp.lexd: $(GENDIR) $(GT_LEXD_ROOT) $(GT_LEXD_SRCS)
	$(AM_V_at)echo "# automatically generated combined lexd do not touch" > $@
	$(AM_V_GEN)cat $(GT_LEXD_ROOT) $(GT_LEXD_SRCS) >> $@

.generated/lexicon.tmp.att: .generated/lexicon.tmp.lexd
	$(AM_V_LEXD)"$(LEXD)" $< $@

.generated/lexicon.tmp.hfst: .generated/lexicon.tmp.att
	$(AM_V_HT2F)"$(SED)" -E 's/\t<(@[A-Z]\.LEX\.[A-Za-z0-9]+@)>\t/\t\1\t/g' \
		< $< |\
		$(SED) -E 's/\t<([^\t]+)>\t/\t+\1\t/g' |\
		$(HFST_TXT2FST) $(HFST_FORMAT) -o $@

.generated/lexicon.hfst: .generated/lexicon.tmp.hfst
	$(AM_V_CP)cp -v $< $@


