            words.default.hfst \
            initial_letters.list.default.hfst \
            initial_letters.regex.default.hfst \
            initial_letters.all.default.hfst \
            final_strings.default.hfst

CLEANFILES=$(GT_COMMON_SPELLER_HFST) *.hfst easteregg.*

