####### Add corpus-based weights: #######
# Use: surfweights.CORPUSNAME.hfst and CORPUSNAME.unitweight
SURFWEIGHTS=$(CORPUSNAME).surfweights.hfst
UNITWEIGHT=$(CORPUSNAME).unitweight.txt

####### Where the corpus text for the weighting comes from: #######
# The frequency weighting needs running text. It can come from two places:
#
#  1. the corpus repos corpus-$(GLANG), corpus-$(GLANG)-x-closed and
#     corpus-$(GLANG)-x-sensitive, checked out beside this repo;
#  2. the copy of some corpus text committed under weights/*.raw.txt.
#
# (1) is preferred: it is the whole corpus instead of a slice of it that has to
# be refreshed by hand, and the non-public corpora must never be committed into
# a language repo at all, so reading them at build time is the only way to use
# them.
# (2) is the fallback, so a checkout with no corpus repos beside it still
# builds a speller -- a missing corpus repo is never an error.
#
# The repos are looked for by make rather than by configure, because whether
# they are there is a fact about the moment the speller is built, not about the
# moment the tree was configured: CI clones them in a step of its own, often
# after configuring, and a developer who clones one afterwards should not have
# to know to reconfigure. Only the directories are stat'ed, never their
# contents.
#
# Override with either of:
#   make GIELLA_CORPUS_ROOT=/path/to/checkouts
#   make GIELLA_CORPUS_REPOS="corpus-xxx"   # (or in the environment) only these
#   make GIELLA_CORPUS_DIRS="/path/to/corpus-xxx /path/to/corpus-xxx-x-closed"
#   make GIELLA_CORPUS_DIRS=              # force the in-tree copy
#
# In CI (the CI environment variable set, as Buildkite and GitHub Actions do)
# nothing is guessed. Which corpus a speller was weighted from must not depend
# on which directories happen to be on the runner: a step that reuses a built
# tree without the corpus repos would otherwise rebuild the speller from the
# in-tree copy and test that instead of the one shipped. So in CI the build
# must say which corpus repos it uses -- GIELLA_CORPUS_REPOS, from the
# environment or the command line, empty meaning the in-tree copy (most
# languages have no corpus repo) -- every one it names must be checked out
# beside the language repo, and a corpus with no text for the language is an
# error rather than a quiet fallback. divvun-actions clones the repos it can,
# sets GIELLA_CORPUS_REPOS to those, and gives later steps the same ones.
# Shallow clones are enough: only the working tree is read, never the history.
# A build with the closed corpus and one without both produce a valid
# speller, and a measurably different one.
GIELLA_CORPUS_ROOT = $(top_srcdir)/..
GIELLA_CORPUS_REPOS ?= corpus-$(GLANG) corpus-$(GLANG)-x-closed \
    corpus-$(GLANG)-x-sensitive
GIELLA_CORPUS_DIRS = $(patsubst %/converted,%,$(wildcard \
    $(foreach d,$(GIELLA_CORPUS_REPOS),$(GIELLA_CORPUS_ROOT)/$(d)/converted)))
CORPUS2RAWTEXT = $(GTCORE)/scripts/corpus2rawtext.py

# Shell test: true on a CI runner.
GIELLA_IN_CI = { test -n "$$CI" && test "$$CI" != false && test "$$CI" != 0 ; }
# Whether the corpus was named from outside this file, and the directories that
# naming asks for (missing ones included, unlike GIELLA_CORPUS_DIRS's default).
GIELLA_CORPUS_NAMED = $(strip \
    $(if $(filter-out file,$(origin GIELLA_CORPUS_REPOS)),yes) \
    $(if $(filter-out file,$(origin GIELLA_CORPUS_DIRS)),yes))
GIELLA_CORPUS_WANTED = $(if $(filter file,$(origin GIELLA_CORPUS_DIRS)),\
    $(foreach r,$(GIELLA_CORPUS_REPOS),$(GIELLA_CORPUS_ROOT)/$(r)),\
    $(GIELLA_CORPUS_DIRS))

# The resolved source list, as a file, so that a tree which gains or loses a
# corpus repo rebuilds the weighting instead of silently keeping the text it
# assembled last time. The recipe always runs; the file only changes, and so
# only triggers a rebuild, when the answer changes. In CI it first checks that
# the corpus was named and is all there (see "In CI" above).
.generated/$(CORPUSNAME).corpussrc: FORCE $(GENDIR)
	$(AM_V_at)if $(GIELLA_IN_CI) ; then \
	    if test -z '$(GIELLA_CORPUS_NAMED)' ; then \
	        echo "$@: CI is set, so the speller corpus is not guessed from what is checked out: set GIELLA_CORPUS_REPOS to the corpus repos this build uses (empty for the in-tree weights/*.raw.txt)" >&2 ; \
	        exit 1 ; \
	    fi ; \
	    for d in $(GIELLA_CORPUS_WANTED) ; do \
	        test -d "$$d/converted" || { \
	            echo "$@: CI is set and the speller corpus names $$d, which has no converted/ directory" >&2 ; \
	            exit 1 ; } ; \
	    done ; \
	fi
	$(AM_V_at)printf '%s\n' '$(GIELLA_CORPUS_DIRS)' > $@.tmp
	$(AM_V_at)if cmp -s $@.tmp $@ ; then rm -f $@.tmp ; else mv -f $@.tmp $@ ; fi

FORCE:
.PHONY: FORCE

# Assemble the corpus text. Extraction from the corpus XML lives in giella-core
# next to corpus2unigramlm.py, not in the language repo: it is the same job for
# every language, and it is a step of the weighting pipeline whose other steps
# are already here. It is a stdlib-only script rather than a call to ccat so
# that "no corpus repo" stays the only way this step can decline to run -- a
# build must not start failing because CorpusTools is not installed.
# The raw-file prerequisite is deliberately NOT $(srcdir)-qualified: VPATH then
# accepts either the copy shipped in the source tree or one generated into the
# build directory by a language-local rule, and both get the same treatment --
# preferred-over by the corpus repos when those are present, used verbatim when
# they are not.
.generated/%.corpus.txt: weights/%.raw.txt \
                         .generated/$(CORPUSNAME).corpussrc $(GENDIR)
	$(AM_V_at)if test -n '$(strip $(GIELLA_CORPUS_DIRS))' ; then \
	    echo "  CORPUS   $@ <- $(GIELLA_CORPUS_DIRS)" ; \
	    $(PYTHON) $(CORPUS2RAWTEXT) -l $(GLANG) -o $@ $(GIELLA_CORPUS_DIRS) \
	      || { if $(GIELLA_IN_CI) ; then \
	               echo "$@: CI is set and $(GIELLA_CORPUS_DIRS) holds no $(GLANG) text" >&2 ; \
	               exit 1 ; \
	           fi ; \
	           echo "  CORPUS   $@ <- $< (extraction found no $(GLANG) text)" ; \
	           cp $< $@ ; } ; \
	else \
	    echo "  CORPUS   $@ <- $< ($(if $(GIELLA_CORPUS_NAMED),no corpus repo named,no corpus-$(GLANG) checkout beside $(abs_top_srcdir)))" ; \
	    cp $< $@ ; \
	fi

.generated/%.hfst: weights/%.att $(GENDIR)
	$(AM_V_GEN)$(HFST_TXT2FST) $(HFST_FLAGS) -f openfst-tropical $< -o $@


# add tropical weights to the corpus.
#
# The speller corpus goes through .corpus.txt, the corpus-discovery step, and
# that rule is EXPLICIT, not a pattern. It has to be: as a pattern rule it
# loses the implicit-rule search to the raw-file fallback below, because GNU
# make prefers a candidate whose prerequisites already exist (weights/%.raw.txt
# does, via VPATH) over one that needs another implicit rule chained in front
# (.corpus.txt does not exist on a clean tree and, being only a pattern target,
# does not "ought to exist" either). Rule order in this file cannot save it --
# an earlier comment here claimed it could, and was wrong: on every clean tree
# the fallback won and the speller was silently weighted from the small in-tree
# file. An explicit rule for the concrete target skips that contest entirely,
# and naming .corpus.txt as an explicit prerequisite is what lets its own
# pattern rule fire.
# One pass writes both the weights file and the unit weight, so both are named
# here: as separate rules the unit weight had no recipe of its own, a value
# left over from an older maxweight or a smaller corpus was never refreshed,
# and every compound was priced against it while simplex words looked correct.
# Temporaries because make before 4.3 ignores the grouping and may run this
# once per output under -j.
.generated/$(CORPUSNAME).tropical.txt .generated/$(UNITWEIGHT) &: \
		.generated/$(CORPUSNAME).corpus.txt \
		$(srcdir)/weights/config.json $(GENDIR)
	$(AM_V_GEN)$(CORPUS2UNIGRAMLM) -i $< \
		-w .generated/$(CORPUSNAME).tropical.txt.$$$$ \
		-m .generated/$(UNITWEIGHT).$$$$ \
		-c $(srcdir)/weights/config.json && \
	mv -f .generated/$(CORPUSNAME).tropical.txt.$$$$ \
		.generated/$(CORPUSNAME).tropical.txt && \
	mv -f .generated/$(UNITWEIGHT).$$$$ .generated/$(UNITWEIGHT)

# Any other stem takes the raw file directly, shipped or generated into the
# build directory (VPATH covers both); no corpus discovery for those:
.generated/%.tropical.txt: weights/%.raw.txt $(srcdir)/weights/config.json $(GENDIR)
	$(AM_V_GEN)$(CORPUS2UNIGRAMLM) -i $< -w $@ \
		-m .generated/$(UNITWEIGHT) -c $(srcdir)/weights/config.json

# $(AM_V_GEN)$(CORPUS2UNIGRAMLM) -i $< \
#		-w $@ -m .generated/$(UNITWEIGHT)


# build an fst of surface forms with tropical weights for each word form:
.generated/%.surfs.hfst: .generated/%.tropical.txt
	$(AM_V_STR2FST)cat $< |\
		$(HFST_STRINGS2FST) -j $(HFST_FLAGS) -f openfst-tropical -o $@

# Build an fst with surface form weights that also handles compounds:
.generated/%.surfweights.hfst: .generated/%.surfs.hfst \
                    .generated/word-boundary.hfst
	$(AM_V_HMINIM)$(HFST_MINIMIZE) $(HFST_FLAGS) -i $< -o $@

# Commented out the repetition build step - we only want to promote the compouns
# actually found in the corpus.
#	$(AM_V_HCONCAT)$(HFST_CONCATENATE) $(HFST_FLAGS) word-boundary.hfst $< \
#		| $(HFST_REPEAT) $(HFST_FLAGS) -f 0 -t inf \
#		| $(HFST_CONCATENATE) $< - \
#		| $(HFST_MINIMIZE) -o $@

# Remove word forms covered by the corpus.
#
# NOTE: nothing depends on this target -- the edge that did is the commented-out
# line below -- so it does not run in a normal build. Its prerequisite also had
# a literal `%` in it, which GNU make does not expand for an explicit target, so
# asking for it by name failed with "No rule to make target" before any recipe
# ran. Named concretely now, matching UW_SPELLER_SRC in the desktop fragment.
.generated/unitweighted_limited.hfst: \
			.generated/generator-desktopspeller-gt-norm-freq_weighted.hfst \
							$(UW_SPELLER_SRC)
	$(AM_V_FST2FST)$(HFST_FST2FST) --format=foma -i $(UW_SPELLER_SRC) -o $@.tmpfoma.hfst
	$(AM_V_FST2FST)$(HFST_FST2FST) --format=foma -i $< -o $<.tmpfoma.hfst
	$(AM_V_HXFST)$(PRINTF) "read regex \
	~[ @\"$<.tmpfoma.hfst\".u ] \
	.o. @\"$@.tmpfoma.hfst\" \
	; \n\
	save stack $@\n\
	quit\n" | $(HFST_XFST) -p $(MORE_VERBOSITY) --format=foma

# Add the unit weight to each unit in compounds, both dynamic and lexical:
#unitweighted.hfst: unitweighted_limited.hfst
.generated/unitweighted.hfst: $(UW_SPELLER_SRC) \
                   .generated/$(UNITWEIGHT)
	$(AM_V_REWEIGHT)$(HFST_FST2FST) --format=openfst-tropical -i $< \
		| $(HFST_REWEIGHT) $(HFST_FLAGS) \
		-e -a $$(cat .generated/$(UNITWEIGHT)) \
		-o $@

# Keep these intermediate targets when building using --debug:
.SECONDARY: .generated/spellercorpus.sort.txt \
            .generated/spellercorpus.uniq.txt \
            .generated/spellercorpus.surfs.hfst \
            .generated/spellercorpus.corpus.txt \
            .generated/spellercorpus.corpussrc \
            .generated/spellercorpus.tropical.txt \
            .generated/spellercorpus.typecount.txt \
            .generated/pellercorpus.wordcount.txt \
            .generated/word-boundary.hfst \
            .generated/generator-*-gt-norm-freq_weighted.hfst \
            .generated/generator-*-gt-norm-unit_weighted.hfst \
            .generated/generator-*-gt-norm-norm_weighted.hfst \
            .generated/generator-*-gt-norm-tag_weighted.hfst  \
            .generated/$(SURFWEIGHTS) \
            .generated/$(UNITWEIGHT)
